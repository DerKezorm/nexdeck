# Copy to .env next to docker-compose.yml and adjust.

# Time zone for the server side (clocks in the browser follow the browser).
TZ=Europe/Berlin

# The host user that should own the files in ./data.
PUID=1000
PGID=1000

# Encrypts stored API keys and signs sessions. Generate one with
#   openssl rand -base64 48
# and never change it afterwards: every stored secret is bound to it.
# Empty means nexdeck generates one into ./data/secret.key on first start.
NEXDECK_SECRET_KEY=

# How browsers reach nexdeck. Required for OpenID Connect and Web Push.
NEXDECK_PUBLIC_URL=https://deck.example.com

# Only when nexdeck runs below a sub path, e.g. /deck.
# NEXDECK_URL_BASE=

# The Docker socket's group id on the host, when the automatic detection
# fails: stat -c %g /var/run/docker.sock
# DOCKER_GID=999

# INFO is the default; DEBUG logs every adapter request.
NEXDECK_LOG_LEVEL=INFO

# Start every widget with invented data, for a look around.
# NEXDECK_DEMO=1
