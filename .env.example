# Copy to .env next to docker-compose.yml and adjust.

# Time zone for the server side (clocks in the browser follow the browser).
TZ=Europe/Berlin

# The host user that should own the files in ./data.
PUID=1000
PGID=1000

# Encrypts stored API keys and signs sessions. Generate one with
#   openssl rand -base64 48
# and never change it afterwards: every stored secret is bound to it.
# Empty means nexdeck generates one into ./data/secret.key on first start.
NEXDECK_SECRET_KEY=

# How browsers reach nexdeck. Required for OpenID Connect and Web Push.
NEXDECK_PUBLIC_URL=https://deck.example.com

# The Docker socket's group id on the host, when the automatic detection
# fails: stat -c %g /var/run/docker.sock
# DOCKER_GID=999

# INFO is the default; DEBUG logs every adapter request.
NEXDECK_LOG_LEVEL=INFO

# Start every widget with invented data, for a look around.
# NEXDECK_DEMO=1

# Let outbound calls from notification channels, Web Push, RSS cards and
# reachability checks reach 127.0.0.1 and the link-local range.
#
# Off, and it should stay off. Addresses that come from a connection an
# administrator made are not affected: a Radarr on localhost keeps working
# either way. This is about the fields every member may fill in, where the
# answer comes back to them and the field would otherwise be a way of asking
# what else is listening beside the server. Set it only when a notification
# service really does live next to nexdeck.
# NEXDECK_ALLOW_LOOPBACK_TARGETS=1

# How much one account may leave lying in ./data/uploads, in megabytes.
# 0 means no ceiling. Roughly seventeen backgrounds at the largest size the
# upload allows.
# NEXDECK_UPLOAD_QUOTA_MB=200

# How long rows nobody reads again are kept, in days. 0 switches a sweep off
# and lets that table grow, which is what all three did before 0.1.1.
#
# The action log is the record of who pressed what and belongs to the
# operator. The notice centre is an inbox: a message nobody opened in three
# months is not going to be opened. An outage is a fact about a service, worth
# keeping longer, and one that has not ended yet is never swept whatever its
# age, because it is the reason a card is red.
# NEXDECK_KEEP_ACTION_LOG_DAYS=90
# NEXDECK_KEEP_NOTICES_DAYS=90
# NEXDECK_KEEP_OUTAGES_DAYS=365
