{
  "about": "The public parts a skin may style, and what each stands for inside nexdeck. A skin names parts, never classes: the compiler turns [data-part=name] into the selectors here, so the markup can change without breaking a skin. The frontend tests read this file too (every selector must still exist in the code), and the AI build guide is written from it.",
  "version": 1,
  "groups": {
    "colour": ["color", "background-color", "accent-color", "caret-color"],
    "background": ["background", "background-image", "background-size", "background-position", "background-repeat", "background-clip", "background-origin"],
    "border": ["border", "border-width", "border-style", "border-color", "border-top", "border-right", "border-bottom", "border-left", "border-top-width", "border-right-width", "border-bottom-width", "border-left-width", "border-top-color", "border-right-color", "border-bottom-color", "border-left-color", "border-radius", "border-top-left-radius", "border-top-right-radius", "border-bottom-right-radius", "border-bottom-left-radius", "border-image", "border-image-source", "border-image-slice", "border-image-width", "border-image-repeat", "border-image-outset", "outline", "outline-width", "outline-style", "outline-color", "outline-offset"],
    "shadow": ["box-shadow", "text-shadow"],
    "type": ["font-family", "font-weight", "font-size", "font-style", "letter-spacing", "line-height", "text-transform", "text-decoration", "text-decoration-color", "font-variant-numeric"],
    "effect": ["opacity", "filter", "mask", "mask-image", "mask-size", "mask-repeat", "mask-position", "mask-mode", "image-rendering"],
    "motion": ["transition", "transition-property", "transition-duration", "transition-timing-function", "transition-delay", "animation", "animation-name", "animation-duration", "animation-timing-function", "animation-delay", "animation-iteration-count", "animation-direction", "animation-fill-mode", "transform", "transform-origin", "translate", "rotate", "scale"],
    "svg": ["stroke", "fill", "stroke-width", "stroke-dasharray", "stroke-linecap", "stroke-linejoin"],
    "pseudo": ["content", "display", "position", "inset", "top", "right", "bottom", "left", "width", "height", "margin", "padding", "z-index"]
  },
  "container_refused": ["opacity", "filter", "mask", "mask-image", "mask-size", "mask-repeat", "mask-position", "mask-mode", "transform", "translate", "rotate", "scale"],
  "fonts": {
    "inter": "'Inter Variable'",
    "system": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue'",
    "plex": "'IBM Plex Sans Variable'",
    "atkinson": "'Atkinson Hyperlegible Next Variable'",
    "geist": "'Geist Variable'",
    "mono": "'JetBrains Mono Variable'",
    "pixel": "'Pixelify Sans Variable'"
  },
  "parts": {
    "app-bar": {"group": "frame", "label": "The bar across the top", "selectors": ["header.glass-strong.app-bar"], "pseudo": ["::after"], "container": true},
    "tab-bar": {"group": "frame", "label": "The tab bar at the bottom of a phone", "selectors": ["nav.glass-strong.app-bar"], "pseudo": [], "container": true},
    "menu": {"group": "frame", "label": "A menu that drops down", "selectors": ["[role='menu']"], "pseudo": [], "container": true},
    "menu-item": {"group": "frame", "label": "One entry of a menu", "selectors": ["[role='menuitem']"], "pseudo": []},
    "desk": {"group": "frame", "label": "The ground behind the cards", "selectors": ["[data-background]"], "pseudo": ["::before", "::after"], "container": true},
    "desk-tile": {"group": "frame", "label": "A layer over the desk for a pattern or a picture of the skin's own", "selectors": ["[data-desk-tile]"], "pseudo": ["::before", "::after"]},
    "page-window": {"group": "frame", "label": "A page that is not a board (settings, notices, chronicle)", "selectors": ["main[data-shell]"], "pseudo": [], "container": true},
    "page-nav": {"group": "frame", "label": "The list of sections beside a settings page", "selectors": ["main[data-shell] nav a"], "pseudo": [], "states": {"current": ["main[data-shell] nav a[aria-current]"]}},
    "panel": {"group": "frame", "label": "A box of settings", "selectors": ["main[data-shell] .glass.p-5"], "pseudo": [], "container": true},
    "overlay": {"group": "frame", "label": "The shade behind a dialog", "selectors": [".overlay > [aria-hidden]:first-child"], "pseudo": []},
    "dialog": {"group": "frame", "label": "A dialog in the middle of the screen", "selectors": [".overlay > .glass-strong:not([data-alert])"], "pseudo": ["::after"], "container": true},
    "dialog-title": {"group": "frame", "label": "The head of a dialog", "selectors": [".overlay > .glass-strong:not([data-alert]) > header"], "pseudo": ["::before", "::after"]},
    "sheet": {"group": "frame", "label": "A panel that slides in from the side", "selectors": [".overlay > aside.glass-strong"], "pseudo": [], "container": true},
    "toast": {"group": "frame", "label": "A short message in a corner", "selectors": [".glass-strong[role='status']"], "pseudo": []},
    "card": {"group": "card", "label": "A card on a board", "selectors": [".card.glass:not(.card-plain)"], "pseudo": ["::before", "::after"], "pseudo_unless": "[data-cards='liquid']", "container": true, "states": {"ok": [".card.glass:not(.card-plain)[data-status='ok']"], "warn": [".card.glass:not(.card-plain)[data-status='warn']"], "bad": [".card.glass:not(.card-plain)[data-status='bad']"], "unknown": [".card.glass:not(.card-plain)[data-status='unknown']"]}},
    "card-titlebar": {"group": "card", "label": "The head of a card", "selectors": [".card.glass:not(.card-plain) > header"], "pseudo": ["::before", "::after"], "states": {"ok": [".card.glass:not(.card-plain)[data-status='ok'] > header"], "warn": [".card.glass:not(.card-plain)[data-status='warn'] > header"], "bad": [".card.glass:not(.card-plain)[data-status='bad'] > header"], "unknown": [".card.glass:not(.card-plain)[data-status='unknown'] > header"]}},
    "card-title": {"group": "card", "label": "The name of a card", "selectors": [".card.glass:not(.card-plain) > header > h3"], "pseudo": ["::before", "::after"]},
    "card-status": {"group": "card", "label": "The light in the head of a card", "selectors": [".card.glass:not(.card-plain) > header > .dot"], "pseudo": [], "states": {"ok": [".card.glass:not(.card-plain) > header > .dot[data-status='ok']"], "warn": [".card.glass:not(.card-plain) > header > .dot[data-status='warn']"], "bad": [".card.glass:not(.card-plain) > header > .dot[data-status='bad']"], "unknown": [".card.glass:not(.card-plain) > header > .dot[data-status='unknown']"]}},
    "card-controls": {"group": "card", "label": "The buttons of a card while it is edited", "selectors": [".card-controls"], "pseudo": []},
    "button": {"group": "control", "label": "Any button", "selectors": [".btn"], "pseudo": ["::before", "::after"], "states": {"pressed": [".btn[aria-pressed='true']"], "disabled": [".btn:disabled"]}},
    "button-primary": {"group": "control", "label": "The button that does what a dialog is for", "selectors": [".btn.btn-accent"], "pseudo": ["::before", "::after"]},
    "button-danger": {"group": "control", "label": "A button that deletes or stops something", "selectors": [".btn.btn-danger"], "pseudo": []},
    "button-flat": {"group": "control", "label": "A small button with only a symbol", "selectors": [".btn.btn-flat"], "pseudo": ["::before", "::after"]},
    "input": {"group": "control", "label": "A field to type in", "selectors": ["input.input", "textarea.input"], "pseudo": []},
    "select": {"group": "control", "label": "A list to choose from", "selectors": ["select.input"], "pseudo": []},
    "checkbox": {"group": "control", "label": "A box to tick", "selectors": ["input[type='checkbox']", "input[type='radio']"], "pseudo": [], "states": {"checked": ["input[type='checkbox']:checked", "input[type='radio']:checked"]}},
    "slider": {"group": "control", "label": "A slider", "selectors": ["input[type='range']"], "pseudo": []},
    "toggle": {"group": "control", "label": "A switch that is on or off", "selectors": ["button[role='switch']"], "pseudo": [], "states": {"on": ["button[role='switch'][aria-checked='true']"]}},
    "tab": {"group": "control", "label": "A tab", "selectors": ["[role='tab']"], "pseudo": ["::before", "::after"], "states": {"current": ["[role='tab'][aria-selected='true']"]}},
    "option": {"group": "control", "label": "An entry of a list to pick from", "selectors": ["[role='option']"], "pseudo": [], "states": {"current": ["[role='option'][aria-selected='true']"]}},
    "number": {"group": "data", "label": "A big number on a card", "selectors": [".value-number", ".text-2xl.num", ".text-3xl.num", ".text-4xl.num"], "pseudo": []},
    "progress": {"group": "data", "label": "The track of a bar that fills", "selectors": [".bar"], "pseudo": [], "states": {"ok": [".bar[data-status='ok']"], "warn": [".bar[data-status='warn']"], "bad": [".bar[data-status='bad']"]}},
    "progress-fill": {"group": "data", "label": "The part of a bar that is filled", "selectors": [".bar > i"], "pseudo": [], "states": {"ok": [".bar[data-status='ok'] > i"], "warn": [".bar[data-status='warn'] > i"], "bad": [".bar[data-status='bad'] > i"]}},
    "status-dot": {"group": "data", "label": "A light that says how something is", "selectors": [".dot"], "pseudo": [], "states": {"ok": [".dot[data-status='ok']"], "warn": [".dot[data-status='warn']"], "bad": [".dot[data-status='bad']"], "unknown": [".dot[data-status='unknown']"]}},
    "chip": {"group": "data", "label": "A small label", "selectors": [".chip"], "pseudo": ["::before", "::after"]},
    "logo": {"group": "data", "label": "The logo of a service", "selectors": [".card img", ".app-bar img"], "pseudo": []}
  }
}
